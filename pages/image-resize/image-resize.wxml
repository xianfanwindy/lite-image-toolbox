<view class="page resize-page">
  <view class="card intro-card">
    <text class="page-title">尺寸调整</text>
    <text class="hint">图片仅在本机处理，不会上传</text>
  </view>

  <button class="secondary-button choose-button" bindtap="chooseImage" disabled="{{processing}}">
    {{source ? '更换图片' : '选择图片'}}
  </button>

  <view wx:if="{{source}}" class="card image-card">
    <image class="preview-image" src="{{source.path}}" mode="aspectFit" />
    <view class="meta-row">
      <text>{{source.width}} × {{source.height}}</text>
      <text>{{sourceSizeText}}</text>
    </view>
  </view>

  <view wx:if="{{source}}" class="card mode-card">
    <text class="section-title">调整方式</text>
    <view class="mode-row">
      <button class="mode-pill {{mode === 'original' ? 'selected' : ''}}" data-mode="original" bindtap="selectMode" disabled="{{processing}}">原始尺寸</button>
      <button class="mode-pill {{mode === 'half' ? 'selected' : ''}}" data-mode="half" bindtap="selectMode" disabled="{{processing}}">50%</button>
      <button class="mode-pill {{mode === 'custom' ? 'selected' : ''}}" data-mode="custom" bindtap="selectMode" disabled="{{processing}}">自定义</button>
    </view>
    <view wx:if="{{mode === 'custom'}}" class="custom-section">
      <view class="input-row">
        <label class="input-label" for="resize-width">宽</label>
        <input id="resize-width" class="size-input" type="number" value="{{customWidth}}" bindinput="onWidthInput" disabled="{{processing}}" />
        <text class="input-unit">px</text>
      </view>
      <view class="input-row">
        <label class="input-label" for="resize-height">高</label>
        <input id="resize-height" class="size-input" type="number" value="{{customHeight}}" bindinput="onHeightInput" disabled="{{processing}}" />
        <text class="input-unit">px</text>
      </view>
      <view class="lock-row">
        <text>锁定宽高比例</text>
        <switch checked="{{lockAspectRatio}}" color="#07c160" bindchange="onLockChange" disabled="{{processing}}" />
      </view>
      <text wx:if="{{!lockAspectRatio}}" class="warning">关闭比例锁后图片可能变形</text>
    </view>
    <text wx:if="{{targetSizeText}}" class="hint output-hint">预计输出：{{targetSizeText}} px</text>
  </view>

  <button class="primary-button process-button" bindtap="resizeImage" loading="{{processing}}" disabled="{{processing || !source}}">
    {{processing ? '处理中' : '开始调整'}}
  </button>
  <view wx:if="{{errorMessage}}" class="error-message">{{errorMessage}}</view>

  <view wx:if="{{resultPath}}" class="card image-card result-card">
    <text class="section-title">调整结果</text>
    <image class="preview-image" src="{{resultPath}}" mode="aspectFit" />
    <view class="meta-row">
      <text>{{targetSizeText}} px</text>
      <text>{{resultSizeText}}</text>
    </view>
    <button class="primary-button save-button" bindtap="saveResult" loading="{{saving}}" disabled="{{saving}}">保存到相册</button>
    <ad-slot unit-id="{{resultBannerUnitId}}" />
  </view>

  <canvas id="processor-canvas" type="2d" class="canvas-host"></canvas>
</view>
