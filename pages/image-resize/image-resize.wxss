.intro-card,
.image-card,
.mode-card {
  margin-bottom: 24rpx;
}

.page-title {
  display: block;
  margin-bottom: 12rpx;
  font-size: 34rpx;
  font-weight: 600;
}

.choose-button,
.process-button {
  margin-bottom: 24rpx;
}

.preview-image {
  display: block;
  width: 100%;
  height: 360rpx;
  border-radius: 12rpx;
  background: #f7f8fa;
}

.meta-row,
.mode-row,
.input-row,
.lock-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.meta-row {
  margin-top: 18rpx;
  color: #6b7280;
  font-size: 26rpx;
}

.section-title {
  display: block;
  margin-bottom: 20rpx;
  font-size: 30rpx;
  font-weight: 600;
}

.mode-row {
  gap: 14rpx;
}

.mode-pill {
  flex: 1;
  min-height: 76rpx;
  padding: 0 12rpx;
  border: 2rpx solid #d8e7dc;
  border-radius: 38rpx;
  background: #fff;
  color: #3f4b43;
  font-size: 26rpx;
  line-height: 72rpx;
}

.mode-pill::after {
  border: 0;
}

.mode-pill.selected {
  border-color: #07c160;
  background: #eaf8ef;
  color: #068a46;
  font-weight: 600;
}

.custom-section {
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #edf0ee;
}

.input-row {
  min-height: 84rpx;
  margin-bottom: 16rpx;
}

.input-label {
  width: 60rpx;
  color: #3f4b43;
  font-size: 28rpx;
}

.size-input {
  flex: 1;
  min-height: 72rpx;
  padding: 0 18rpx;
  border: 1rpx solid #d8e7dc;
  border-radius: 10rpx;
  background: #fff;
  font-size: 28rpx;
}

.input-unit {
  width: 52rpx;
  padding-left: 14rpx;
  color: #7a857d;
  font-size: 26rpx;
}

.lock-row {
  min-height: 84rpx;
  color: #3f4b43;
  font-size: 28rpx;
}

.warning {
  display: block;
  margin-top: 8rpx;
  color: #c56a00;
  font-size: 25rpx;
}

.output-hint {
  display: block;
  margin-top: 18rpx;
}

.result-card {
  margin-top: 24rpx;
}

.save-button {
  margin-top: 20rpx;
}
