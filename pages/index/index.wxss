.home-page {
  padding-bottom: 48rpx;
}

.hero {
  display: flex;
  flex-direction: column;
  padding: 40rpx 32rpx;
  border-radius: 24rpx;
  background: #eaf8f0;
}

.hero-title {
  font-size: 44rpx;
  font-weight: 700;
}

.hero-slogan {
  margin-top: 16rpx;
  color: #059b4d;
  font-size: 30rpx;
  font-weight: 600;
}

.hero-description {
  margin-top: 12rpx;
  color: var(--color-muted);
  font-size: 26rpx;
}

.tool-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 24rpx;
}

.tool-card {
  display: flex;
  flex: 1 1 calc((100% - 16rpx) / 2);
  flex-direction: column;
  min-width: 210rpx;
  min-height: 230rpx;
  margin: 0;
  padding: 28rpx;
  border: 1px solid #e5ebe8;
  border-radius: 24rpx;
  box-sizing: border-box;
  color: var(--color-text);
  background: #ffffff;
  line-height: normal;
  text-align: left;
}

.tool-card::after {
  border: 0;
}

.tool-card-hover {
  background: #f3fbf6;
}

.tool-icon {
  display: flex;
  width: 64rpx;
  height: 64rpx;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  color: #059b4d;
  background: #eaf8f0;
  font-size: 30rpx;
  font-weight: 700;
}

.tool-title {
  margin-top: 24rpx;
  font-size: 32rpx;
  font-weight: 600;
}

.tool-description {
  margin-top: 12rpx;
  color: var(--color-muted);
  font-size: 24rpx;
}

.privacy-note {
  display: block;
  margin: 36rpx 0 20rpx;
  color: var(--color-muted);
  font-size: 24rpx;
  text-align: center;
}
