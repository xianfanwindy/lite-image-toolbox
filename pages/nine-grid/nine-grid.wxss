.intro-card,
.image-card,
.result-card,
.choose-button,
.generate-button {
  margin-bottom: 24rpx;
}

.page-title,
.section-title,
.crop-hint,
.save-progress {
  display: block;
}

.page-title {
  margin-bottom: 12rpx;
  font-size: 34rpx;
  font-weight: 600;
}

.section-title {
  margin-bottom: 20rpx;
  font-size: 30rpx;
  font-weight: 600;
}

.source-preview {
  display: block;
  width: 100%;
  height: 360rpx;
  border-radius: 12rpx;
  background: #f7f8fa;
}

.meta-row {
  display: flex;
  justify-content: space-between;
  margin-top: 18rpx;
  color: #6b7280;
  font-size: 26rpx;
}

.crop-hint,
.save-progress {
  margin-top: 14rpx;
}

.grid-preview {
  display: flex;
  flex-wrap: wrap;
  overflow: hidden;
  border-radius: 12rpx;
  background: #f7f8fa;
}

.grid-cell {
  position: relative;
  box-sizing: border-box;
  width: 33.3333%;
  padding-top: 33.3333%;
  border: 1rpx solid #fff;
}

.grid-cell image {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.save-button {
  margin-top: 20rpx;
}
